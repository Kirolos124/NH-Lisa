#
# NetHunter fragment for Xiaomi 11 Lite 5G NE (lisa)
# Base chain (from sm8350-common BoardConfigCommon.mk + lisa BoardConfig.mk):
#   vendor/lahaina-qgki_defconfig
#   vendor/debugfs.config
#   vendor/xiaomi_QGKI.config
#   vendor/lisa_QGKI.config
#   + THIS FILE (applied last via merge_config.sh)
#
# Kernel: LineageOS/android_kernel_xiaomi_sm8350, branch lineage-23.2
# Pinned revision: 7ede20c8692e0e0fc044754429e33cfd1d75c40d (5.4.302, matches LOS 23.2-20260922)
# Already present in base (verified): CFG80211=y, MAC80211=y, USB_CONFIGFS=y, USB_CONFIGFS_F_HID=y
# This fragment adds the rest. Re-declaring present symbols is harmless (merge_config dedupes).
#

# A. USB HID Gadget & BadUSB Support
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_G_HID=y

# B. Networking & Wi-Fi Packet Injection (Monitor Mode)
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211_LEDS=y

# B2. WLAN master switch + vendor submenus (base defconfig disables all of
# these because internal WiFi is via cnss/qcacld; without WLAN=y every USB
# WiFi driver below is silently dropped by olddefconfig).
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_REALTEK=y

# C. External USB Wi-Fi Drivers
# Atheros AR9271 / AR7010
CONFIG_ATH9K_HTC=m
CONFIG_ATH9K_HTC_DEBUGFS=y

# Ralink / MediaTek
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y

# Realtek
CONFIG_RTL8187=m
CONFIG_RTL8192CU=m

# D. System V IPC & Chroot Compatibility
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
