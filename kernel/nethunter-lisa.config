#
# BISECT ROUND N2: everything EXCEPT sysvipc (N1 proved sysvipc hangs boot)
# - USB HID: already in base (CONFIGFS F_HID), nothing needed
# - Monitor helpers (WEXT/LEDS) + WLAN gates + USB drivers (=m)
# - CNSS pins: stock builds them =y (internal WiFi dead without them)
# Base already has: USB_CONFIGFS, F_HID, CFG80211, MAC80211 (verified).
#

# B. Monitor-mode helpers
# NOTE: CFG80211_WEXT and MAC80211_LEDS are deliberately NOT enabled.
# They change cfg80211/mac80211 type layouts -> different symbol CRCs ->
# stock vendor wlan.ko refuses to load ("disagrees about version") ->
# internal WiFi dead. Modern monitor tools use nl80211 (no WEXT needed),
# LED triggers are cosmetic. Dropped for CRC parity with stock.
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# B2. WLAN master switch + vendor submenus (base disables all)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_REALTEK=y

# C. External USB Wi-Fi drivers (modules)
CONFIG_ATH9K_HTC=m
CONFIG_ATH9K_HTC_DEBUGFS=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RTL8187=m
CONFIG_RTL8192CU=m

# E. Internal WiFi core: stock =y, our merge demotes to =m (WiFi dead).
# Pin to stock values.
CONFIG_CNSS_QMI_SVC=y
CONFIG_CNSS_UTILS=y
