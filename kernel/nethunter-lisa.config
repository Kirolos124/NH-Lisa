#
# BISECT ROUND N1: SYSVIPC group ONLY (pristine boots, full fragment hangs)
# If this boots -> chroot support works, keep. Then N2 adds WiFi modules.
# Base already has: USB_CONFIGFS, F_HID, CFG80211, MAC80211 (verified).
#

# D. System V IPC & Chroot Compatibility
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
