#
# NetHunter fragment for lisa — FINAL (N4).
# Lessons baked in:
# - NO sysvipc: hangs boot at splash (bisect N1, 2x confirmed).
# - NO legacy USB_G_HID: same (kept ConfigFS F_HID from base).
# - NO CFG80211_WEXT: changes cfg80211 type CRCs -> stock wlan.ko refuses
#   to load ("disagrees about version") -> internal WiFi dead.
# - MAC80211_LEDS stays forced =y via ATH9K_HTC select (harmless: qcacld
#   uses cfg80211 only, proven by wlan.ko loading on N3).
# - Drivers BUILT-IN (=y): always available, no insmod/SELinux/permissive
#   dance, survive reboots; USB drivers probe only on hotplug (boot-safe).
# - CNSS pins match stock (internal WiFi core must be built-in).
# Base already provides: USB_CONFIGFS, CONFIGFS_F_HID, CFG80211, MAC80211.
#

# WLAN master switch + vendor submenus (base disables all of them)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_REALTEK=y

# External USB Wi-Fi drivers, built-in (AR9271 / RT3070-class / RTL8187 /
# RTL8192CU / RTL8192EU-basic). Deps auto-resolve to =y. Firmware loads
# from /vendor/firmware at hotplug (chroot firmware pkg covers gaps).
CONFIG_ATH9K_HTC=y
CONFIG_ATH9K_HTC_DEBUGFS=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RTL8187=y
CONFIG_RTL8192CU=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y

# Internal WiFi core: stock builds them =y (as =m the internal WiFi dies).
CONFIG_CNSS_QMI_SVC=y
CONFIG_CNSS_UTILS=y
